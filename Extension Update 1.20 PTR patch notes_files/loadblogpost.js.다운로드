    a.href = `#${h.id}`;
    a.textContent = h.textContent;

    li.appendChild(a);
    sidebarUl.appendChild(li);
  });
}

async function parseUnitShowcase(htmlContent) {
  const blockRe = /{{\s*unitshowcase\s*}}([\s\S]*?){{\s*\/unitshowcase\s*}}/g;

  const makeHTML = (videos) => {
    const esc = (x) => String(x ?? '').replace(/"/g, '&quot;');
    const dataItems = videos.map(v => `
      <div
        data-src="${esc(v.src)}"
        data-icon="${esc(v.icon)}"
        data-status="${esc(v.status)}"
        data-name="${esc(v.name)}"
        ${v.type ? `data-type="${esc(v.type)}"` : ''}
        ${v.duration ? `data-duration="${esc(v.duration)}"` : ''}
      ></div>
    `).join('');

    return `
<div class="unitshowcase">
  <div class="unitshowcase-header">
    <h2 class="unitshowcase-status"></h2>
    <h4 class="unitshowcase-name"></h4>
  </div>
  <div class="unitshowcase-container">
    <button class="unitshowcase-arrow left"></button>
    <button class="unitshowcase-arrow right"></button>
    <div class="unitshowcase-player">
      <video class="unitshowcase-video" loading="lazy" muted playsinline></video>
      <img class="unitshowcase-corner-icon" src="" alt="Unit Icon">
      <svg class="unitshowcase-border" viewBox="0 0 500 275"></svg>
      <div class="unitshowcase-progress-track">
        <div class="unitshowcase-progress-fill"></div>
      </div>
    </div>
  </div>
  <ul class="unitshowcase-indicators"></ul>
  <div class="unitshowcase-data" style="display:none">
    ${dataItems}
  </div>
</div>`;
  };

  // Parse each block
  return htmlContent.replace(blockRe, (_m, body) => {
    // Split into entries by blank lines
    const chunks = body
      .split(/\n{2,}/)
      .map(s => s.trim())
      .filter(Boolean);

    const videos = chunks.map(chunk => {
      const obj = {};
      chunk.split(/\n+/).forEach(line => {
        // allow "key=value" or "key: value" and ignore bullets like "- key: value"
        const cleaned = line.replace(/^\s*-\s*/, '');
        const m = cleaned.match(/^\s*([a-zA-Z]+)\s*[:=]\s*(.+?)\s*$/);
        if (!m) return;
        const key = m[1].toLowerCase();
        let val = m[2];

        // strip wrapping quotes if present
        const q = val.match(/^"(.*)"$|^'(.*)'$/);
        if (q) val = q[1] ?? q[2];

        obj[key] = val;
      });
      return obj;
    }).filter(v => v.src);

    if (videos.length === 0) {
      console.warn('UnitShowcase: no valid items in block, leaving original text.');
      return _m; // keep original text so you can see the issue
    }

    return makeHTML(videos);
  });
}

// Format Blog Date

function parseBuffNerf(content) {
  content = decodeHtmlEntities(content);

  content = content.replace(
    /{{buff}}([\s\S]+?){{\/buff}}/g,
    '<span class="buff">$1</span>'
  );

  content = content.replace(
    /{{nerf}}([\s\S]+?){{\/nerf}}/g,
    '<span class="nerf">$1</span>'
  );

  content = content.replace(
    /{{adjust}}([\s\S]+?){{\/adjust}}/g,
    '<span class="adjust">$1</span>'
  );

  content = content.replace(
    /->|→/g,
    '<span class="arrow">→</span>'
  );

  return content;
}

function buildUnitShowcaseMarkup(root, videos) {
  const esc = (x) => String(x ?? '').replace(/"/g, '&quot;');
