/**
 * Parse raw changes to determine indentation levels and whether they're list items
 * @param {string[]} rawLines - Raw lines from unit module
 * @return {Array} - Parsed changes with level and content
 */
function parseNestedChanges(rawLines) {
  const parsedChanges = [];

  const useBulletLists = rawLines.some(line => line.startsWith('-'));

  if (!useBulletLists) {
    return rawLines.map(line => ({
      level: 0,
      content: line
    }));
  }

  for (const line of rawLines) {
    const originalLine = line;
    let level = 0;
    let content = line;

    if (line.startsWith('-')) {
      content = line.substring(1).trimStart();
      level = 0; // Top level bullet
    }

    else {
      const match = line.match(/^(\s+)(-\s*.+)$/);
      if (match) {
        const indentation = match[1].length;
        content = match[2].substring(1).trimStart(); 
        level = Math.ceil(indentation / 2); 
      } else if (line.match(/^\s+/)) {
        const indentation = line.match(/^\s+/)[0].length;
        content = line.trimStart();
        level = Math.ceil(indentation / 2);
      }
    }

    parsedChanges.push({
      level,
      content,
      originalLine
    });
  }

  return parsedChanges;
}

// Load unit data from units.json
async function loadUnitsMap() {
  const locale = localStorage.getItem('locale') || 'enUS';

  let base = {};
  try {
    const res = await fetch('/assets/data/units.json');
    if (res.ok) base = await res.json();
  } catch {}

  if (locale === 'enUS') return base;

  try {
    const res = await fetch(`/assets/data/units.${locale}.json`);
    if (!res.ok) return base;
    const localeData = await res.json();
    const merged = { ...base };
    for (const [id, entry] of Object.entries(localeData)) {
      merged[id] = { ...base[id], ...entry };
    }
    return merged;
  } catch {
    return base;
  }
}

async function loadUnitData(unitId) {
  const locale = localStorage.getItem('locale') || 'enUS';

  let base = {};
  try {
    const res = await fetch('/assets/data/units.json');
    if (res.ok) {
      const data = await res.json();
      base = data[unitId] || {};
    }
  } catch {}

  if (locale === 'enUS') return base;

  try {
    const res = await fetch(`/assets/data/units.${locale}.json`);
    if (!res.ok) return base;
    const data = await res.json();
    const localeEntry = data[unitId];
    if (!localeEntry) return base;
    return { ...base, ...localeEntry };
  } catch {
    return base;
  }
}

/**
 * Generate HTML for the unit module with nested lists
 * @param {object} unitData - Data for the unit (name, icon, etc.)
 * @param {Array} changes - Array of processed changes with level and content
 * @return {string} - HTML for the unit module
 */
function generateUnitModule(unitData, changes) {
  if (!unitData.name) return '';

  const hasNestedItems = changes.some(change => change.level > 0);

  let changesHTML;

  if (!hasNestedItems) {
    changesHTML = changes.map(change => {
      const useListItem = change.originalLine && change.originalLine.trim().startsWith('-');

      if (useListItem) {
        return `<li>${change.content}</li>`;
      } else {
        return `<p>${change.content}</p>`;
      }
    }).join('');

    if (changes.some(change => change.originalLine && change.originalLine.trim().startsWith('-'))) {
      changesHTML = `<ul>${changesHTML}</ul>`;
    }
  } else {
    changesHTML = generateNestedListHTML(changes);
  }

  return `
    <div class="unit-module-wrapper">
      <div class="unit-icon-wrapper">
        <div class="unit-icon-border">
          <img src="/assets/img/elements/btn-border-element.webp" alt="Unit Border" width="100" height="100" />
        </div>
        <div class="unit-icon">
          <img src="${unitData.icon}" alt="Unit Icon" width="100" height="100" />
        </div>
      </div>

      <div class="unit-module">
        <div class="unit-title-bar">
          <h3 class="unit-title">${unitData.name}</h3>
        </div>

        <div class="unit-changes">
          ${changesHTML}
        </div>
      </div>
    </div>
  `;
}

/**
 * Generate properly nested HTML list from parsed changes
 * @param {Array} changes - Array of parsed changes with level and content
 * @return {string} - Nested list HTML
 */
function generateNestedListHTML(changes) {
  if (!changes || changes.length === 0) return '';

  let html = '';
  let currentLevel = -1;
  let inList = false;

  for (let i = 0; i < changes.length; i++) {
    const change = changes[i];
    const isListItem = change.originalLine && change.originalLine.trim().startsWith('-');

    if (isListItem) {
      if (!inList) {
        html += '<ul>';
        inList = true;
        currentLevel = 0;
      }

      if (change.level > currentLevel) {
        for (let j = currentLevel; j < change.level; j++) {
          html += '<ul>';
        }
      } else if (change.level < currentLevel) {
        for (let j = currentLevel; j > change.level; j--) {
          html += '</ul></li>';
        }
      } else if (currentLevel > 0 && i > 0) {
        html += '</li>';
      }

      html += `<li>${change.content}`;
      currentLevel = change.level;
    } else {
      if (inList) {
        while (currentLevel >= 0) {
          html += '</li></ul>';
          currentLevel--;
        }
        inList = false;
      }
      html += `<p>${change.content}</p>`;
    }
  }

  if (inList) {
    html += '</li>';
    while (currentLevel >= 0) {
      html += '</ul>';
      currentLevel--;
    }
  }

  return html;
}

