// ─────────────────────────────────────────────────────────────────────────────
// POST — custom tag parsers
// Each function receives the current HTML string and returns a modified string.
// Available in all post types (regular and cinematic alike).
// ─────────────────────────────────────────────────────────────────────────────

// Helper: parse key="value" or key='value' attribute pairs from a tag string
function parseCinematicAttrs(str) {
  const attrs = {};
  const re = /(\w[\w-]*)=["']([^"']*)["']/g;
  let m;
  while ((m = re.exec(str)) !== null) attrs[m[1]] = m[2];
  return attrs;
}

// TAG 1 — {{split image="..." side="left|right"}}...{{/split}}
// Reuses existing .project-row / .project-row--reverse CSS.
function parseSplitRow(html) {
  return html.replace(/{{\s*split\s+([\s\S]*?)}}([\s\S]*?){{\s*\/split\s*}}/g, (_m, attrStr, inner) => {
    const a     = parseCinematicAttrs(attrStr);
    const image = a.image || '';
    const side  = (a.side || 'left').toLowerCase();
    const rowClass = side === 'right' ? 'project-row project-row--reverse' : 'project-row';
    // inner is still raw markdown — parse it independently so it renders correctly
    const parsedInner = marked.marked(inner.trim());
    return `
<div class="${rowClass}">
  <div class="project-row__img project-row__img--cinematic">
    <img src="${image}" alt="">
  </div>
  <div class="project-row__content">
    ${parsedInner}
  </div>
</div>`;
  });
}

// TAG 2 — comparison slider (single-pair or multi-pair)
// Single: {{compare before="..." after="..." label-before="..." label-after="..." animate="true"}}
// Multi:  {{compare animate="true"}}\n| label | before | after |\n...\n{{/compare}}
function compareMedia(src, alt, cssClass) {
  if (src.toLowerCase().endsWith('.webm')) {
    return '<video class="' + cssClass + '" autoplay muted loop playsinline draggable="false">'
      + '<source src="' + src + '" type="video/webm"></video>';
  }
  return '<img class="' + cssClass + '" src="' + src + '" alt="' + alt + '" draggable="false">';
}

function compareSelectorThumb(src) {
  if (src.toLowerCase().endsWith('.webm')) {
    return '<video class="img-compare-selector__thumb" muted preload="metadata" draggable="false">'
      + '<source src="' + src + '" type="video/webm"></video>';
  }
  return '<img class="img-compare-selector__thumb" src="' + src + '" alt="" loading="lazy">';
}

function buildCompareSlider(before, after, lBefore, lAfter, animate) {
  const animClass = animate ? ' img-compare--animate' : '';
  return '<div class="img-compare' + animClass + '" style="--pos:50%">'
    + compareMedia(after,  lAfter,  'img-compare__img img-compare__img--after')
    + compareMedia(before, lBefore, 'img-compare__img img-compare__img--before')
    + '<div class="img-compare__divider"><div class="img-compare__handle">'
    + '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M8.59 16.59L4 12l4.59-4.59L7.17 6 1 12l6.17 6zm6.82 0L20 12l-4.59-4.59L16.83 6 23 12l-6.17 6z" fill="#fff"/></svg>'
    + '</div></div>'
    + '<span class="img-compare__label img-compare__label--before">' + lBefore + '</span>'
    + '<span class="img-compare__label img-compare__label--after">' + lAfter + '</span>'
    + '</div>';
}

async function parseCompare(html) {
  const unitsMap = await loadUnitsMap();
  function resolveLabel(val) { return (val && unitsMap[val]) ? unitsMap[val].name : val; }

  // Multi-pair (wrapping syntax) — must run before self-closing to avoid mismatches
  html = html.replace(/{{\s*compare\s*([\s\S]*?)}}([\s\S]*?){{\s*\/compare\s*}}/g, function (_m, attrStr, inner) {
    const a       = parseCinematicAttrs(attrStr);
    const animate = a.animate === 'true';

    const tmp = document.createElement('div');
    tmp.innerHTML = marked.marked(inner.trim());
    const table = tmp.querySelector('table');
    if (!table) return marked.marked(inner.trim());

    const headers  = Array.from(table.querySelectorAll('thead th')).map(function (th) { return th.textContent.trim().toLowerCase(); });
    const iLabel   = headers.indexOf('label');
    const iBefore  = headers.indexOf('before');
    const iAfter   = headers.indexOf('after');
    const iLBefore = headers.indexOf('label-before');
    const iLAfter  = headers.indexOf('label-after');
    if (iBefore < 0 || iAfter < 0) return tmp.innerHTML;

    const rows = Array.from(table.querySelectorAll('tbody tr')).map(function (tr) {
      const cells = Array.from(tr.querySelectorAll('td'));
      function cell(i) { return i >= 0 && cells[i] ? cells[i].textContent.trim() : ''; }
      return {
        label:   resolveLabel(cell(iLabel)),
        before:  cell(iBefore),
        after:   cell(iAfter),
        lBefore: resolveLabel(cell(iLBefore) || 'Before'),
        lAfter:  resolveLabel(cell(iLAfter)  || 'After'),
      };
    }).filter(function (r) { return r.before && r.after; });
    if (rows.length === 0) return tmp.innerHTML;

    const selectorBtns = rows.map(function (r, i) {
      return '<button class="img-compare-selector__btn' + (i === 0 ? ' active' : '') + '" data-compare-idx="' + i + '">'
        + compareSelectorThumb(r.before)
        + '<span class="img-compare-selector__label">' + (r.label || ('Option ' + (i + 1))) + '</span>'
        + '</button>';
    }).join('');

    const panels = rows.map(function (r, i) {
      return '<div class="img-compare-panel' + (i === 0 ? ' active' : '') + '">'
        + buildCompareSlider(r.before, r.after, r.lBefore, r.lAfter, i === 0 && animate)
        + '</div>';
    }).join('');

    return '<div class="img-compare-wrap">'
      + '<div class="img-compare-selector">' + selectorBtns + '</div>'
      + '<div class="img-compare-panels">' + panels + '</div>'
      + '</div>';
  });

  // Single-pair (self-closing, backward-compatible)
  html = html.replace(/{{\s*compare\s+([\s\S]*?)\s*}}/g, function (_m, attrStr) {
    const a = parseCinematicAttrs(attrStr);
    if (!a.before || !a.after) return '';
    return buildCompareSlider(a.before, a.after, resolveLabel(a['label-before'] || 'Before'), resolveLabel(a['label-after'] || 'After'), a.animate === 'true');
  });

  return html;
}

// TAG 3 — {{map-gallery}}...table...{{/map-gallery}}
// Tabbed gallery; clicking an image opens Magnific Popup fullscreen zoom.
function parseMapGallery(html) {
  return html.replace(/{{\s*map-gallery\s*}}([\s\S]*?){{\s*\/map-gallery\s*}}/g, (_m, inner) => {
    const tmp = document.createElement('div');
    tmp.innerHTML = inner;
    const table = tmp.querySelector('table');
    if (!table) return inner;

    const headers = Array.from(table.querySelectorAll('thead th'))
                         .map(th => th.textContent.trim().toLowerCase());
    const tabIdx   = headers.indexOf('tab');
    const imageIdx = headers.indexOf('image');
    if (tabIdx < 0 || imageIdx < 0) return inner;

    const rows = Array.from(table.querySelectorAll('tbody tr')).map(tr => {
      const cells = Array.from(tr.querySelectorAll('td'));
      return {
        tab:   cells[tabIdx]   ? cells[tabIdx].textContent.trim()   : '',
        image: cells[imageIdx] ? cells[imageIdx].textContent.trim() : '',
      };
    }).filter(r => r.tab && r.image);

    if (rows.length === 0) return inner;

    const uid = 'mg' + Math.random().toString(36).slice(2, 7);

    const tabs = rows.map((r, i) =>
      `<button class="map-gallery__tab${i === 0 ? ' active' : ''}" data-mg-idx="${i}">${r.tab}</button>`
    ).join('');

    const panels = rows.map((r, i) =>
      `<div class="map-gallery__panel${i === 0 ? ' active' : ''}" data-mg-panel="${uid}-${i}">
         <a href="${r.image}" class="map-gallery__zoom-link">
           <img src="${r.image}" alt="${r.tab}" class="map-gallery__img">
         </a>
       </div>`
    ).join('');

    return `
<div class="map-gallery" id="${uid}">
  <div class="map-gallery__tabs">${tabs}</div>
  <div class="map-gallery__panels">${panels}</div>
</div>`;
  });
}

// TAG 3 — {{featured title="..."}}...table...{{/featured}}
// Responsive 3-column card grid for highlighted content (units, reworks, features, etc.).
function parseFeatured(html) {
  return html.replace(/{{\s*featured\s*([\s\S]*?)}}([\s\S]*?){{\s*\/featured\s*}}/g, (_m, attrStr, inner) => {
    const a     = parseCinematicAttrs(attrStr);
    const title = a.title || '';

    const tmp = document.createElement('div');
    tmp.innerHTML = inner;
    const table = tmp.querySelector('table');
    if (!table) return inner;

    const headers = Array.from(table.querySelectorAll('thead th'))
                         .map(th => th.textContent.trim().toLowerCase());
    const rows = Array.from(table.querySelectorAll('tbody tr')).map(tr => {
      const cells = Array.from(tr.querySelectorAll('td'));
      const row = {};
      headers.forEach((h, i) => { row[h] = cells[i] ? cells[i].textContent.trim() : ''; });
      return row;
    }).filter(r => r.name || r.image);

    if (rows.length === 0) return inner;

    const cards = rows.map(r => `
<div class="col-lg-4 col-md-6">
  <div class="featured-rework-card">
    ${r.image ? `<img src="${r.image}" alt="${r.name||''}" class="featured-rework-card__img">` : ''}
    <h4 class="featured-rework-card__name">${r.name||''}</h4>
    ${r.description ? `<p class="featured-rework-card__desc">${r.description}</p>` : ''}
  </div>
</div>`).join('');

    return `
<div class="featured-reworks">
  ${title ? `<h3 class="featured-reworks__title">${title}</h3>` : ''}
  <div class="row">${cards}</div>
</div>`;
  });
}

// 0) Helper: generate a slug from text
const slugCounts = {};

function slugify(text) {
  const base = text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w가-힣 ]+/g, '')
    .trim()
    .replace(/\s+/g, '-');

  // Ensure uniqueness
  let slug = base;
  if (slugCounts[base] !== undefined) {
    slugCounts[base] += 1;
    slug = `${base}-${slugCounts[base]}`;
  } else {
    slugCounts[base] = 0;
  }

  return slug;
}

async function parseTOC(content) {
  // Inline "Quick Access" TOC retired — strip the token from any legacy posts
  // that still include it. Heading IDs are still assigned elsewhere if needed
  // for future anchor linking.
  return content.replace(/{{toc}}/g, '');
}

function initSidebarTOC() {
